// Xadrez Arena - schema
// Provider: PostgreSQL. Para dev local, use Docker, Neon, Supabase ou Vercel Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  rating       Int      @default(1200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet            Wallet?
  matchesAsWhite    Match[]              @relation("WhiteUser")
  matchesAsBlack    Match[]              @relation("BlackUser")
  matchesWon        Match[]              @relation("WinnerUser")
  transactions      Transaction[]
  withdrawals       WithdrawalRequest[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(1000) // saldo livre em coins
  locked    Int      @default(0)    // coins em escrow numa partida ativa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  WAGER_LOCK
  WAGER_REFUND
  WAGER_WIN
  WAGER_LOSS
  ADJUSTMENT
}

model Transaction {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Int             // pode ser negativo (saída) ou positivo (entrada)
  balanceAfter Int
  matchId   String?
  note      String?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

enum MatchStatus {
  WAITING   // criada, aguardando 2º jogador
  ACTIVE    // em jogo
  FINISHED  // concluída
  CANCELLED // cancelada antes de iniciar
}

enum MatchResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  WHITE_RESIGN
  BLACK_RESIGN
  WHITE_TIMEOUT
  BLACK_TIMEOUT
  ABORTED
}

model Match {
  id            String       @id @default(cuid())
  wager         Int          // valor da aposta por jogador (cada um deposita esse valor)
  status        MatchStatus  @default(WAITING)
  result        MatchResult?

  whiteUserId   String?
  whiteUser     User?        @relation("WhiteUser", fields: [whiteUserId], references: [id])
  blackUserId   String?
  blackUser     User?        @relation("BlackUser", fields: [blackUserId], references: [id])

  creatorId     String       // quem criou (whiteUserId OU blackUserId)

  winnerId      String?
  winner        User?        @relation("WinnerUser", fields: [winnerId], references: [id])

  fen           String       @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  pgn           String       @default("")
  moveCount     Int          @default(0)
  turn          String       @default("w") // 'w' ou 'b'

  pot           Int          @default(0)   // total em escrow (wager * 2)
  rakeBps       Int          @default(500) // 5% rake da casa
  payout        Int          @default(0)   // valor pago ao vencedor (após rake)

  createdAt     DateTime     @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime     @updatedAt

  moves         Move[]

  @@index([status, createdAt])
}

model Move {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ply       Int
  san       String
  uci       String
  fenAfter  String
  byUserId  String
  createdAt DateTime @default(now())

  @@index([matchId, ply])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model WithdrawalRequest {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int              // em coins
  method      String           // PIX, USDT, etc (texto livre)
  destination String           // chave pix, endereço carteira, etc
  status      WithdrawalStatus @default(PENDING)
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, createdAt])
}
